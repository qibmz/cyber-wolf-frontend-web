# ===== 所有环境共用的配置（.env：Next.js 与 orval 都会读取）=====

# 站点配置
NEXT_PUBLIC_SITE_NAME=Cyber Wolf
NEXT_PUBLIC_SITE_DESCRIPTION=Cyber Wolf 官方 Web 应用

# Reown AppKit Project ID（在 https://dashboard.reown.com 创建项目获取）
# 用于钱包登录（WalletConnect / Coinbase / 注入式钱包等）
NEXT_PUBLIC_PROJECT_ID=efac2e95e932d442f33434c195c7097c

# 后端服务地址（Next.js rewrite 代理目标；本地默认本机）
# 正式：https://cyber-wolf-backend.qibmz.com
# 测试：https://cyber-wolf-backend-dev.qibmz.com
# 生产由 .env.production 覆盖；Preview/develop 请在部署平台设测试域名
BACKEND_URL=http://localhost:3001

# OpenAPI 文档地址（orval 生成 API 客户端时使用）
ORVAL_API_URL=http://localhost:3001/docs-json
