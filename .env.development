# ===== 开发环境（pnpm dev 时自动加载，覆盖 .env）=====

# 应用 URL（Reown AppKit 元数据使用，须与当前运行域名 origin 一致）
# 本地开发用 localhost
NEXT_PUBLIC_APP_URL=http://localhost:3000

# 默认仍走本机后端（见 .env 的 BACKEND_URL）。
# 若要直连测试后端，取消下面两行注释（或在 .env.local 覆盖）：
# BACKEND_URL=https://cyber-wolf-backend-dev.qibmz.com
# ORVAL_API_URL=https://cyber-wolf-backend-dev.qibmz.com/docs-json
