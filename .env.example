# ===== 环境变量模板 =====
# 本项目按「环境」拆分了 env 文件（Next.js 按 NODE_ENV 自动加载）：
#   .env            所有环境共用（站点名、Project ID、后端、OpenAPI）
#   .env.development 开发环境（pnpm dev），覆盖 .env
#   .env.production  生产环境（next build / next start），覆盖 .env
#   .env.local      本地机器覆盖（git 忽略，可存本机私有配置）
#
# 复制本文件到上述对应文件并填值即可。

# ----- 共享（放 .env）-----
NEXT_PUBLIC_SITE_NAME=Cyber Wolf
NEXT_PUBLIC_SITE_DESCRIPTION=Cyber Wolf 官方 Web 应用
# Reown AppKit Project ID（在 https://dashboard.reown.com 创建项目获取）
NEXT_PUBLIC_PROJECT_ID=
# 后端服务地址（Next.js rewrite 代理目标）；生产可用部署环境变量覆盖
BACKEND_URL=http://localhost:3001
# OpenAPI 文档地址（orval 生成 API 客户端时使用）
ORVAL_API_URL=http://localhost:3001/docs-json

# ----- 开发（放 .env.development）-----
# 应用 URL，须与当前运行域名 origin 一致
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ----- 生产（放 .env.production）-----
# 应用 URL，须与部署域名 origin 一致（去尾部斜杠）
NEXT_PUBLIC_APP_URL=https://cyber-wolf.qibmz.com
# 生产后端地址：不同时在部署平台用环境变量覆盖
# BACKEND_URL=https://api.cyber-wolf.qibmz.com
