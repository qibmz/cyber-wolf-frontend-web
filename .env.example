# 站点配置
NEXT_PUBLIC_SITE_NAME=Cyber Wolf
NEXT_PUBLIC_SITE_DESCRIPTION=Cyber Wolf 官方 Web 应用

# 应用 URL（Reown AppKit 元数据使用，须与部署域名 origin 一致）
# 本地开发可填 http://localhost:3000；生产填真实域名（去尾部斜杠）
NEXT_PUBLIC_APP_URL=https://cyber-wolf.qibmz.com

# Reown AppKit Project ID（在 https://dashboard.reown.com 创建项目获取）
# 用于钱包登录（WalletConnect / Coinbase / 注入式钱包等）
NEXT_PUBLIC_PROJECT_ID=

# 后端服务地址（Next.js rewrite 代理目标）
BACKEND_URL=http://localhost:3001

# OpenAPI 文档地址（orval 生成 API 客户端时使用）
ORVAL_API_URL=http://localhost:3001/docs-json
